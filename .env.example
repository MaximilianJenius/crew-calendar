# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never expose this to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# --- App ---
# Public URL of the deployed site (no trailing slash), e.g. https://crew-calendar.vercel.app
APP_URL=http://localhost:3000
# Code people type the first time they join, so strangers can't get in.
# At least 12 characters; joining is switched off with a shorter one. Make one with: openssl rand -base64 12
GROUP_INVITE_CODE=change-me-to-something-long
GROUP_NAME=Our Crew
MAX_MEMBERS=10

# --- Claude (reads pasted messages) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Calendar direct add (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored Google refresh tokens. 32 random bytes, base64. Make one with: openssl rand -base64 32
GOOGLE_TOKEN_KEY=

# --- Email alerts via Resend (optional) ---
RESEND_API_KEY=
# Must be on a domain you verified in Resend, e.g. "Crew Calendar <alerts@yourdomain.com>"
ALERT_FROM_EMAIL=

# --- Daily digest cron (Vercel sends this as a Bearer token automatically) ---
# Required: without it the digest refuses to run. Make one with: openssl rand -hex 32
CRON_SECRET=make-a-long-random-string
